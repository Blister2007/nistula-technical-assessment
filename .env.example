# Copy this file to .env and fill in your Worker URL.
# The .env file is gitignored so nothing sensitive gets committed.
#
# WORKER_URL is the public URL of your deployed Cloudflare Worker.
# The Worker itself holds the real Anthropic API key as a Cloudflare
# secret - we never put the raw key in this backend or in this repo.
#
# See /worker/cloudflare-worker.js for the Worker code and setup steps.

WORKER_URL=https://nistula-claude-proxy.your-name.workers.dev
